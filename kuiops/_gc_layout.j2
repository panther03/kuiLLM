{# Shared C-view layout selection for the addmm-style GEMM instantiations.

   Both SuperGEMM and TensorCore2D.To take C as an arbitrary read-only view
   rather than a matrix with a fixed layout, so the dense (rows x cols) matrix
   and the broadcast length-`cols` row bias are the SAME verified kernel at two
   different `vtlayout`s.  Choosing between them is therefore a specialization
   decision and belongs here, not in a second backend.

   `cvt_bcastC` is named because `cvtlayout_extended`'s dimension argument is
   refined (`SZ.fits e`), which typeclass resolution cannot discharge on its
   own. #}

{% macro cvt_instance(cbcast) %}
{% if cbcast %}
inline_for_extraction noextract
instance cvt_bcastC (rows cols : szp)
  : RO.cvtlayout (bcastC (SZ.v rows) (SZ.v cols))
  = RO.cvtlayout_extended (RO.vtlayout_of_tlayout (l1_forward (SZ.v cols))) (SZ.v rows)
{% endif %}
{% endmacro %}

{% macro gc_binder(cbcast, out_et) %}
{% if cbcast %}
    (gC : RO.roarray2 ({{ out_et }}) (bcastC (SZ.v rows) (SZ.v cols)) { RO.is_global gC })
{% else %}
    (gC : RO.roarray2 ({{ out_et }}) (rmC (SZ.v rows) (SZ.v cols)) { RO.is_global gC })
{% endif %}
{% endmacro %}
